<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep dark base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08091A" />
        </shape>
    </item>
    <!-- Teal radial glow in upper-center area -->
    <item
        android:top="-120dp"
        android:left="-120dp"
        android:right="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#2500BCD4"
                android:centerColor="#1200BCD4"
                android:endColor="#0008091A"
                android:centerX="0.5"
                android:centerY="0.35" />
        </shape>
    </item>
</layer-list>
